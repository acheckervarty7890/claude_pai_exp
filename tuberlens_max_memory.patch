+def _normalize_max_memory(
+    max_memory: dict[str, Any] | None,
+) -> dict[Any, Any] | None:
+    """Normalize a max_memory spec into the key form accelerate expects.
+
+    accelerate identifies GPUs by integer index, so keys like "cuda:0" or "0"
+    have to become 0. Non-GPU keys ("cpu", "disk") are passed through.
+    """
+    if not max_memory:
+        return None
+
+    normalized: dict[Any, Any] = {}
+    for device, size in max_memory.items():
+        key: Any = device
+        if isinstance(device, str):
+            stripped = device.strip()
+            if stripped.startswith(("cuda:", "xpu:")):
+                stripped = stripped.split(":", 1)[1]
+            if stripped.isdigit():
+                key = int(stripped)
+            else:
+                key = stripped
+        normalized[key] = size
+    return normalized
+
