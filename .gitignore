# Secrets — never commit
.env

# Python virtualenv & caches
.venv/
__pycache__/
*.pyc

# Local editor/agent settings
.claude/settings.local.json

# Run logs (reproducible noise)
*.log

# Local baseline snapshots (baseline state is preserved in git history on main)
*.baseline.pkl
*.baseline.csv

# Fetched activation caches and locally computed activations (large, reproducible)
dev_activations_*/
eval_activations_*/
activations/

# Credential drops placed in the working tree by the environment
hf_token.json
kaggle.json
